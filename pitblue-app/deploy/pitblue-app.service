[Unit]
Description=Pitblu cook application
After=network-online.target pitblu-core.service
Wants=network-online.target

[Service]
Type=simple
User=pitblue-app
Group=pitblue-app
EnvironmentFile=/etc/pitblue-app/environment
ExecStart=/opt/pitblue-app/venv/bin/pitblue-app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pitblue-app
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
