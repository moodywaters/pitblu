[Unit]
Description=Pitboss Admin Weber iGrill gateway
Wants=network-online.target bluetooth.service
After=network-online.target bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pitboss-admin
Group=pitboss-admin
SupplementaryGroups=bluetooth
WorkingDirectory=/var/lib/pitboss-admin
Environment=PITBOSS_DATABASE_PATH=/var/lib/pitboss-admin/state.sqlite3
Environment=PITBOSS_CONFIG_FILE=/etc/pitboss-admin/config.yaml
Environment=PITBOSS_MANAGED=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/pitboss-admin/environment
ExecStart=/opt/pitboss-admin/current/venv/bin/pitboss-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
StateDirectory=pitboss-admin
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_BLUETOOTH
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
